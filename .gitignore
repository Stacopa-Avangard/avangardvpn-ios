# Xcode
build/
DerivedData/
# CI pins -derivedDataPath here so the SPM checkouts sit at a fixed, cacheable
# path (see .github/workflows/ios-build.yml). Local builds still use Xcode's
# own DerivedData above; this only appears if you run the CI commands by hand.
.derivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# XcodeGen generates the project + Info.plists + entitlements from project.yml —
# project.yml is the single source of truth, so don't commit the generated files.
*.xcodeproj
App/Info.plist
Tunnel/Info.plist
App/*.entitlements
Tunnel/*.entitlements

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (not used, but just in case)
Pods/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets / signing — NEVER commit
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
.env

# macOS
.DS_Store
App/DeviceTest-Info.plist
